# Copy to .env and fill in to enable live AI-assisted reasoning.
# Without a key, the system automatically falls back to a deterministic
# "AI unavailable" path (cases route to NEEDS_REVIEW instead of being
# silently guessed) -- the demo remains fully functional either way.

# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI gateway,
# Groq, local vLLM/Ollama OpenAI-compat servers, etc.)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Synthetic dataset generation
DATASET_SEED=42
DATASET_SIZE=750
