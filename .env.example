# These are only the SEED values read once at process startup (see
# app/settings.py). Once the app is running, the LLM provider/key/model can
# be changed live from the dashboard's Settings panel (gear icon next to
# the AI status pill) -- no restart, no file editing required. Whatever you
# set there is persisted to SQLite and takes precedence over these on the
# next restart too.
#
# Without a key (either here or via the Settings panel), the system
# automatically falls back to a deterministic "AI unavailable" path (cases
# route to human review instead of being silently guessed) -- the demo
# remains fully functional either way.
#
# Default here is OpenRouter + NVIDIA Nemotron Nano 9B (free tier, no
# billing needed -- just sign up at https://openrouter.ai/keys). Any
# OpenAI-compatible endpoint works: OpenAI, NVIDIA NIM, Groq, Azure OpenAI,
# local vLLM/Ollama, etc. -- see app/settings.py:PROVIDER_PRESETS for the
# curated list, or point LLM_BASE_URL at any other compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-nano-9b-v2:free
LLM_TIMEOUT_SECONDS=20

API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Synthetic dataset generation
DATASET_SEED=42
DATASET_SIZE=750
