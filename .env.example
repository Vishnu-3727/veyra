# These are only the SEED values read once at process startup (see
# app/settings.py). Once the app is running, the LLM provider/key/model can
# be changed live from the dashboard's Settings panel (gear icon next to
# the AI status pill) -- no restart, no file editing required. Whatever you
# set there is persisted to SQLite and takes precedence over these on the
# next restart too.
#
# Without a key (either here or via the Settings panel), the system
# automatically falls back to a deterministic "AI unavailable" path (cases
# route to human review instead of being silently guessed) -- the demo
# remains fully functional either way.
#
# Default here is OpenRouter + NVIDIA Nemotron Nano 9B (free tier, no
# billing needed -- just sign up at https://openrouter.ai/keys). Any
# OpenAI-compatible endpoint works: OpenAI, NVIDIA NIM, Groq, Azure OpenAI,
# local vLLM/Ollama, etc. -- see app/settings.py:PROVIDER_PRESETS for the
# curated list, or point LLM_BASE_URL at any other compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-nano-9b-v2:free
LLM_TIMEOUT_SECONDS=20

# Pin the LLM HTTP client to IPv4 (default on). Many laptop/wifi networks advertise an IPv6
# default route but black-hole IPv6 egress; the resolver returns the provider's AAAA record
# first and the HTTP client has no Happy Eyeballs race, so every AI call burned the full
# timeout on an unreachable address. Measured on such a host: 40.1s dual-stack vs 0.04s pinned.
# Set to 0 only on an IPv6-only host (the app also retries unpinned if the pinned attempt
# cannot connect). Transport only -- it can never change a reconciliation decision.
LLM_FORCE_IPV4=1

# Whether POST /settings may aim the LLM client at an endpoint that is NOT one of the curated
# presets in app/settings.py:PROVIDER_PRESETS. Off by default: an HTTP endpoint that accepts any
# URL is a credential-exfiltration primitive (the stored key is sent there as a bearer token)
# and an SSRF probe. Turn it on for a deliberate self-hosted endpoint, then select
# provider="custom" in the Settings panel (https and public hosts only).
# LLM_BASE_URL below is NOT gated by this -- this file is operator-owned configuration.
LLM_ALLOW_CUSTOM_ENDPOINT=0

# Whether a key entered in the dashboard is persisted to data/finance.db so it survives a
# restart (default on -- that is the point of the Settings panel). The DB is chmod 0600 but the
# value is stored in the clear, so set this to 0 if the database file may be copied, backed up,
# or attached to a bug report; the key then lives only in this process (and in this file).
LLM_STORE_CREDENTIAL_ON_DISK=1

# Synthetic dataset generation
DATASET_SEED=42
DATASET_SIZE=750

# API hardening (all optional; safe defaults for the localhost hackathon demo)
# Comma-separated origins allowed to call the API. This list is also the cross-site write
# allowlist: any POST whose `Origin` header is present and not on it is refused with 403, which
# is what stops a random website from driving the local API through the operator's browser.
# `*` is rejected outright. Leave unset and the default follows the port the dashboard is
# actually served on (run.sh exports DASHBOARD_PORT), so `DASHBOARD_PORT=8502 ./run.sh` works
# without touching this. Set it explicitly to override.
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
# Port the static dashboard is served on; also drives the CORS default above.
DASHBOARD_PORT=8501
# Shared-secret API token. Empty (default) disables auth. When set, every endpoint except
# /health requires `X-API-Token: <token>`; the dashboard prompts for it and keeps it in
# sessionStorage only (never localStorage, never a URL, never committed to a file).
API_AUTH_TOKEN=
# Expose FastAPI's interactive docs (/docs, /redoc, /openapi.json). Off by default -- the
# dashboard never uses them and they publish the whole API surface.
API_ENABLE_DOCS=0
# Maximum dataset size POST /dataset/generate will accept (measured ceiling; see README).
# MAX_DATASET_SIZE=10000
